{
  "manifest_version": 3,
  "name": "BiliPlaylist - B站播放列表",
  "version": "1.2.5",
  "description": "在 B 站添加播放列表能力：UP 主空间/搜索页多选批量加入、侧边栏播放列表（排序分组/文件夹）、分P连播、播放进度与窗口模式记忆。",
  "minimum_chrome_version": "109",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "https://www.bilibili.com/*",
    "https://space.bilibili.com/*",
    "https://player.bilibili.com/*",
    "https://t.bilibili.com/*",
    "https://api.bilibili.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.bilibili.com/*",
        "https://space.bilibili.com/*",
        "https://player.bilibili.com/*",
        "https://t.bilibili.com/*"
      ],
      "js": [
        "src/storage.js",
        "src/api.js",
        "src/ui.js",
        "src/player.js",
        "src/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
